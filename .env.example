# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Alpaca (paper trading)
VITE_ALPACA_API_KEY=your-alpaca-key
VITE_ALPACA_SECRET_KEY=your-alpaca-secret
# Paper trading base URL: https://paper-api.alpaca.markets

# DriveWealth (crypto)
VITE_DRIVEWEALTH_CLIENT_ID=your-drivewealth-client-id

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key

# Plaid
VITE_PLAID_CLIENT_ID=your-plaid-client-id
VITE_PLAID_ENV=sandbox

# Brevo (email) — configure in Supabase dashboard under Auth > SMTP Settings
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=your-brevo-login
# BREVO_SMTP_PASS=your-brevo-smtp-key
