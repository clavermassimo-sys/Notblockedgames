rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Message validation
    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'userId', 'userName', 'createdAt']) 
             && data.keys().size() == 4
             && data.text is string && data.text.size() > 0 && data.text.size() <= 500
             && data.userId == request.auth.uid
             && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 50
             && data.createdAt == request.time;
    }

    match /messages/{messageId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(messageId);
      allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming());
      // No updates or deletes allowed for chat messages
    }
  }
}
